# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais committer de vraies clés.

# URL publique du site (local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — clés publiques (utilisables côté navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — clé secrète, UNIQUEMENT côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# Saspay.me — identifiants secrets, UNIQUEMENT côté serveur
# (noms à confirmer avec la documentation Saspay.me)
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
